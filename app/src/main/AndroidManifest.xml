<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- KENO draws its overlay and the K button over the game -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- MediaProjection must run inside a foreground service of type mediaProjection (Android 10+/14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Android 13+: lets the "KENO aktivan" notification (with Stop button) be shown -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: only to be able to open 8 Ball Pool from KENO -->
    <queries>
        <package android:name="com.miniclip.eightballpool" />
    </queries>

    <application
        android:icon="@drawable/ic_keno"
        android:label="KENO"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".CaptureOverlayService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
    </application>
</manifest>
